    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "oidc-client-ts": "^3.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "24.19.2",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
