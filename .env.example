# Copy to .env and adjust. Every variable is optional: compose.yaml and the
# Spring services fall back to the local-development defaults shown here.
# NEVER commit a real .env — it is git-ignored.

# --- PostgreSQL (app database) ---
POSTGRES_DB=docquery
POSTGRES_USER=docquery
POSTGRES_PASSWORD=docquery_local
POSTGRES_PORT=5432

# --- Kafka (KRaft) ---
KAFKA_PORT=9092
# Base64 UUID identifying the single-node cluster; generate a new one with
# /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=ZG9jcXVlcnktbG9jYWwtMQ

# --- S3-compatible object storage (SeaweedFS locally; any S3 in production) ---
S3_PORT=8333
S3_ACCESS_KEY=docquery
S3_SECRET_KEY=docquery_local_secret
S3_REGION=us-east-1
S3_BUCKET=docquery-documents

# --- Keycloak ---
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local
KEYCLOAK_DB_PASSWORD=keycloak_local

# --- Ollama (optional "ai" profile) ---
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Application services ---
API_PORT=8080
WORKER_PORT=8081
# Spring services read these when run outside Docker (defaults shown):
# DB_URL=jdbc:postgresql://localhost:5432/docquery
# DB_USERNAME=docquery
# DB_PASSWORD=docquery_local
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# HEALTH_SHOW_DETAILS=always   # use "never" or "when-authorized" in production
