# Copy to .env and adjust. Every variable is optional: compose.yaml and the
# Spring services fall back to the local-development defaults shown here.
# NEVER commit a real .env — it is git-ignored.
#
# Docker Compose reads this file, and so does api-service when run from source
# (./mvnw spring-boot:run imports ../.env), so both always agree on ports and credentials.

# --- PostgreSQL (app database) ---
POSTGRES_DB=docquery
POSTGRES_USER=docquery
POSTGRES_PASSWORD=docquery_local
# Host port for Postgres. Change it if a local PostgreSQL install already uses 5432
# (e.g. POSTGRES_PORT=55432); api-service run from source follows this value.
POSTGRES_PORT=5432

# --- Kafka (KRaft) ---
KAFKA_PORT=9092
# Base64 UUID identifying the single-node cluster; generate a new one with
# /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=ZG9jcXVlcnktbG9jYWwtMQ

# --- S3-compatible object storage (SeaweedFS locally; any S3 in production) ---
S3_PORT=8333
S3_ACCESS_KEY=docquery
S3_SECRET_KEY=docquery_local_secret
S3_REGION=us-east-1
S3_BUCKET=docquery-documents

# --- Keycloak ---
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local
KEYCLOAK_DB_PASSWORD=keycloak_local

# --- Embeddings & LLM ---
# Local dev uses a native Ollama install on the host (ollama pull nomic-embed-text).
# EMBEDDING_PROVIDER=ollama | openai
EMBEDDING_PROVIDER=ollama
# From source: http://localhost:11434 (default). The "apps" containers default to
# http://host.docker.internal:11434; set http://ollama:11434 to use the "ai" profile container.
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# --- RAG chat (api-service, Phase 5) ---
# CHAT_PROVIDER=ollama | openai | anthropic
CHAT_PROVIDER=ollama
# llama3.2:3b fits a 4 GB GPU; qwen2.5:7b / llama3.1:8b follow the citation rules better (partly on CPU).
OLLAMA_CHAT_MODEL=llama3.2:3b
# OLLAMA_CHAT_NUM_CTX=4096          # context window; 4096 keeps llama3.2:3b fully on a 4 GB GPU
# CHAT_TEMPERATURE=0.1
# CHAT_MAX_TOKENS=1024              # longest answer
# CHAT_HISTORY_MESSAGES=6           # earlier messages sent along for follow-up questions
# CHAT_STREAM_TIMEOUT=5m            # an answer still streaming after this is stopped
# CHAT_READ_TIMEOUT=120s            # first Ollama call loads the model
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=                # secret: set it in the environment, never commit it
# ANTHROPIC_CHAT_MODEL=claude-haiku-5-5
# Hybrid retrieval (defaults shown):
# EMBEDDING_QUERY_PREFIX=search_query:   # nomic-embed-text query prefix (default includes a trailing space); empty for other models
# RETRIEVAL_MAX_SOURCES=5           # passages the model sees and can cite
# RETRIEVAL_MIN_SIMILARITY=0.6      # vector matches below this are "unrelated" (nomic: related ≈ 0.7, unrelated ≈ 0.5)
# RETRIEVAL_FOCUS_EXTRA_CHUNKS=4    # extra passages when a question is about one document (0 = off)
# RETRIEVAL_MAX_CONTEXT_CHARACTERS=8000  # source text per answer; raise with OLLAMA_CHAT_NUM_CTX
# nomic-embed-text expects this task prefix before documents. Leave EMPTY for other models:
# EMBEDDING_DOCUMENT_PREFIX=
# OpenAI instead of Ollama (production). Dimensions 768 match the pgvector HNSW index.
# OPENAI_API_KEY=                       # secret: set it in the environment, never commit it
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=768
# Host port of the optional "ai" profile Ollama container.
OLLAMA_PORT=11434

# --- Application services ---
API_PORT=8080
WORKER_PORT=8081
# Spring services read these when run outside Docker (defaults shown):
# DB_URL=jdbc:postgresql://localhost:${POSTGRES_PORT}/${POSTGRES_DB}   # default; set to override
# DB_USERNAME / DB_PASSWORD default to POSTGRES_USER / POSTGRES_PASSWORD
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# HEALTH_SHOW_DETAILS=always   # use "never" or "when-authorized" in production

# --- Auth (api-service, OAuth2 resource server) ---
# OIDC_ISSUER_URI=http://localhost:8180/realms/docquery    # must equal the token's "iss"
# OIDC_JWK_SET_URI=http://localhost:8180/realms/docquery/protocol/openid-connect/certs
# OIDC_AUDIENCE=docquery-api
# CORS_ALLOWED_ORIGINS=http://localhost:4200               # comma-separated
# DEMO_SEED_ENABLED=true        # seeds "Demo workspace" for the demo users; false in production

# --- Ingestion pipeline (ingestion-worker; defaults shown) ---
# INGESTION_CONCURRENCY=2              # documents processed in parallel per worker
# INGESTION_MAX_ATTEMPTS=4             # tries for transient failures before FAILED + dead-letter topic
# INGESTION_MAX_CHARACTERS=2000000     # extracted text limit per document
# INGESTION_MAX_CHUNKS=5000
# CHUNK_MAX_CHARACTERS=1200            # ~300 tokens
# CHUNK_OVERLAP_CHARACTERS=200
# EMBEDDING_BATCH_SIZE=32              # chunks per embedding request
# EMBEDDING_READ_TIMEOUT=120s          # first Ollama call loads the model
# KAFKA_TOPIC_PARTITIONS=3
# OUTBOX_POLL_INTERVAL=500ms           # api-service: how often queued events are relayed to Kafka

# --- Documents (api-service) ---
# DOCUMENT_MAX_FILE_SIZE=25MB         # largest accepted upload
# DOCUMENT_MAX_REQUEST_SIZE=26MB      # multipart request limit; keep it a little above the file limit
# DOCUMENT_EVENT_STREAM_TIMEOUT=15m   # live-status stream lifetime before the browser reconnects
# DOCUMENT_REQUEUE_AFTER=10m          # a document still "Queued" after this long gets a Retry button
# S3_ENDPOINT=http://localhost:8333   # default (from S3_PORT); leave empty for AWS S3
# S3_PATH_STYLE_ACCESS=true           # needed by SeaweedFS/MinIO; AWS S3 also accepts it
# S3_CREATE_BUCKET=false              # true creates S3_BUCKET at startup (Compose already creates it)
