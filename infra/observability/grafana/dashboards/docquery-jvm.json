    {
      "type": "timeseries",
      "title": "Kafka send / receive p95",
      "description": "Producer acknowledgement time, and listener processing time (worker: the whole pipeline).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, application, messaging_destination_name) (rate(spring_kafka_template_seconds_bucket{application=~\"$application\"}[$__rate_interval])))",
          "legendFormat": "send {{messaging_destination_name}} ({{application}})",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, application, messaging_source_name) (rate(spring_kafka_listener_seconds_bucket{application=~\"$application\"}[$__rate_interval])))",
          "legendFormat": "process {{messaging_source_name}} ({{application}})",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
