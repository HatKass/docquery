    {
      "type": "stat",
      "title": "Errors logged (range)",
      "description": "ERROR log lines; find them in Explore → Loki: {service_namespace=\"docquery\"} | detected_level=\"error\"",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(logback_events_total{application=~\"$application\",level=\"error\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
